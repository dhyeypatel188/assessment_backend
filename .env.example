PORT=3000
# Allowed frontend origin(s), comma-separated. Use * for any (dev only).
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string (Neon / Supabase / Render / local)
DATABASE_URL=postgres://user:password@localhost:5432/transcripts
# Set to "true" for most hosted databases (Neon, Supabase, Render)
DATABASE_SSL=false

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
# Any Gemini Live model that supports audio input + input transcription
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
